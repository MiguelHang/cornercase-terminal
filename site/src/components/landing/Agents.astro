---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const agents: [string, string][] = [
  ['claude', 'claude'],
  ['codex', 'codex'],
  ['gemini', 'gemini'],
  ['opencode', 'opencode'],
  ['cursor', 'cursor-agent'],
  ['copilot', 'copilot'],
  ['amp', 'amp'],
  ['droid', 'droid'],
  ['pi', 'pi'],
  ['qwen', 'qwen'],
  ['kimi', 'kimi'],
  ['cline', 'cline'],
  ['goose', 'goose'],
  ['aider', 'aider'],
];
---

<section class="section agents" id="agents" aria-labelledby="agents-title">
  <div class="wrap grid">
    <div class="copy reveal">
      <p class="eyebrow">Bring your own agent</p>
      <h2 class="h2" id="agents-title">Fourteen agents ready to go. <em>Yours too.</em></h2>
      <p class="lead">
        cornercase knows how to start the coding agents you already use, in the mode you choose: plan, accept edits, a sandbox, or
        a dangerous one shown in red. Point <code>agent_commands</code> at any other binary and it joins the list.
      </p>
      <ul class="chips" aria-label="Agents cornercase knows">
        {
          agents.map(([kind, bin]) => (
            <li title={bin === kind ? undefined : `runs ${bin}`}>
              <span>{kind}</span>
            </li>
          ))
        }
        <li class="yours"><span>+ yours</span></li>
      </ul>
      <a class="link" href={`${base}/docs/reference/agents/`}>How agents start, in detail →</a>
    </div>
    <div class="code reveal">
      <div class="code-bar"><span>~/.config/cornercase/config.json</span><span class="saved">saved at once</span></div>
      <pre><code><span class="p">{'{'}</span>
  <span class="k">"agent"</span><span class="p">:</span> <span class="s">"claude"</span><span class="p">,</span>
  <span class="k">"agent_args"</span><span class="p">: {'{'}</span>
    <span class="k">"claude"</span><span class="p">: [</span><span class="s">"--permission-mode"</span><span class="p">,</span> <span class="s">"plan"</span><span class="p">],</span>
    <span class="k">"codex"</span><span class="p">: [</span><span class="s">"--sandbox"</span><span class="p">,</span> <span class="s">"workspace-write"</span><span class="p">]</span>
  <span class="p">{'}'},</span>
  <span class="k">"agent_commands"</span><span class="p">: {'{'}</span> <span class="k">"mine"</span><span class="p">:</span> <span class="s">"/usr/local/bin/my-agent"</span> <span class="p">{'}'},</span>
  <span class="k">"prompt"</span><span class="p">:</span> <span class="s">"Fix <span class="v">{'{url}'}</span> on <span class="v">{'{branch}'}</span>. Run the tests first."</span><span class="p">,</span>
  <span class="k">"submit"</span><span class="p">:</span> <span class="b">true</span><span class="p">,</span>
  <span class="k">"auto_accept_trust_prompt"</span><span class="p">:</span> <span class="b">true</span>
<span class="p">{'}'}</span></code></pre>
      <p class="note">The agent, its mode and its arguments are a click away in <span class="tui-label">settings</span>; the file is for everything else.</p>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 88px);
    align-items: center;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 30px 0 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 7px 13px;
    border-radius: 9px;
    border: 1px solid var(--line-2);
    background: rgb(255 255 255 / 0.025);
    font-family: var(--font-mono);
    font-size: 13.5px;
    color: var(--text);
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .chips li:hover {
    border-color: var(--cyan);
    background: rgb(69 217 232 / 0.08);
    transform: translateY(-2px);
  }

  .chips .yours {
    border-style: dashed;
    border-color: rgb(135 95 255 / 0.6);
    color: var(--purple-3);
  }

  .link {
    display: inline-block;
    margin-top: 26px;
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--purple);
    padding-bottom: 2px;
  }

  .link:hover {
    color: var(--purple-3);
  }

  .code {
    border-radius: 18px;
    border: 1px solid var(--line);
    background: var(--term);
    overflow: hidden;
    box-shadow: 0 40px 80px -40px rgb(135 95 255 / 0.45);
  }

  .code-bar {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-3);
  }

  .saved {
    color: var(--green);
  }

  pre {
    margin: 0;
    padding: 20px 22px 6px;
    overflow-x: auto;
    font-size: 13.5px;
    line-height: 1.75;
    color: var(--text);
  }

  .k {
    color: var(--cyan);
  }
  .s {
    color: var(--green);
  }
  .v {
    color: var(--yellow);
  }
  .b {
    color: var(--purple-2);
  }
  .p {
    color: var(--text-3);
  }

  .note {
    margin: 0;
    padding: 12px 22px 18px;
    font-size: 14px;
    color: var(--text-3);
  }

  .tui-label {
    padding: 1px 6px;
    border-radius: 3px;
    background: var(--cyan);
    color: #07060b;
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 700;
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
