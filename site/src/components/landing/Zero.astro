---
const swaps: [string[], string, string][] = [
  [['Ctrl', 'b', '%'], 'right-click › split right', 'split a pane'],
  [['Ctrl', 'b', 'c'], '+ tab', 'new terminal'],
  [['Ctrl', 'b', 'n'], 'click the tab', 'switch'],
  [['Ctrl', 'b', 'w'], 'click the search bar', 'jump anywhere'],
  [['Ctrl', 'b', '['], 'drag over text', 'copy'],
  [['Ctrl', 'b', 'd'], 'quit', 'detach'],
];
---

<section class="section zero" id="keys" aria-labelledby="zero-title">
  <div class="wrap grid">
    <div class="copy reveal">
      <p class="eyebrow">Mouse first, keys untouched</p>
      <h2 class="h2" id="zero-title">Your keyboard belongs to <em>your programs.</em></h2>
      <p class="lead">
        cornercase has no keyboard shortcuts of its own. Every key goes to the program in the active pane, so
        <code>Ctrl+B</code>, <code>Ctrl+A</code> and every <code>Alt</code> combo are yours again. Everything cornercase does is a button
        you can see.
      </p>
      <p class="fine">In a dialog, <kbd>Enter</kbd> confirms and <kbd>Esc</kbd> cancels. Everywhere else, cornercase never takes a key.</p>
    </div>
    <div class="board reveal">
      <div class="score" aria-hidden="true">
        <span class="zero-digit">0</span>
        <span class="score-label">prefix keys<br />to remember</span>
      </div>
      <p class="sr-only">Zero prefix keys to remember.</p>
      <table>
        <caption class="sr-only">What you would type in a prefix-key multiplexer, and what you do in cornercase instead</caption>
        <thead>
          <tr><th scope="col">instead of</th><th scope="col">in cornercase</th></tr>
        </thead>
        <tbody>
          {
            swaps.map(([keys, action, what]) => (
              <tr>
                <td>
                  <span class="keys">
                    {keys.map((k) => (
                      <kbd>{k}</kbd>
                    ))}
                  </span>
                </td>
                <td>
                  <span class="action">{action}</span>
                  <span class="what">{what}</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  .fine {
    margin: 22px 0 0;
    color: var(--text-3);
    font-size: 15px;
  }

  kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 28px;
    padding: 0 8px;
    border-radius: 7px;
    border: 1px solid var(--line-2);
    border-bottom-width: 2px;
    background: linear-gradient(#1c1a28, #141220);
    color: var(--text);
    font-size: 13px;
    font-weight: 600;
  }

  .fine kbd {
    height: 24px;
    min-width: 0;
    font-size: 12px;
  }

  .board {
    position: relative;
    padding: clamp(24px, 3vw, 40px);
    border-radius: 20px;
    border: 1px solid var(--line);
    background:
      radial-gradient(500px 260px at 100% 0%, rgb(135 95 255 / 0.12), transparent 70%),
      var(--panel);
  }

  .score {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-bottom: 26px;
  }

  .zero-digit {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(110px, 13vw, 180px);
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 2px var(--purple-2);
    background: linear-gradient(180deg, rgb(135 95 255 / 0.35), transparent 85%);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .score-label {
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  th {
    padding: 0 0 10px;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  td {
    padding: 9px 0;
    border-top: 1px solid var(--line);
    vertical-align: middle;
  }

  .keys {
    position: relative;
    display: inline-flex;
    gap: 5px;
    opacity: 0.55;
  }

  .keys::after {
    content: '';
    position: absolute;
    left: -4px;
    right: -4px;
    top: 50%;
    height: 2px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s cubic-bezier(0.6, 0, 0.2, 1);
  }

  .board.in tr:nth-child(1) .keys::after {
    transition-delay: 0.2s;
  }
  .board.in tr:nth-child(2) .keys::after {
    transition-delay: 0.32s;
  }
  .board.in tr:nth-child(3) .keys::after {
    transition-delay: 0.44s;
  }
  .board.in tr:nth-child(4) .keys::after {
    transition-delay: 0.56s;
  }
  .board.in tr:nth-child(5) .keys::after {
    transition-delay: 0.68s;
  }
  .board.in tr:nth-child(6) .keys::after {
    transition-delay: 0.8s;
  }

  .board.in .keys::after {
    transform: scaleX(1);
  }

  .action {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 3px;
    background: rgb(69 217 232 / 0.1);
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 13.5px;
    font-weight: 600;
  }

  .what {
    margin-left: 10px;
    color: var(--text-3);
    font-size: 14px;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .what {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .keys::after {
      transform: scaleX(1);
    }
  }
</style>
