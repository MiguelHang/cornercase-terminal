---
import Demo from './Demo.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/usecornercase/cornercase-terminal';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="backdrop" aria-hidden="true"></div>
  <div class="wrap">
    <a class="badge" href={repo}>
      <span class="badge-tag">new</span>
      <span>Open source · early and moving fast</span>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </a>
    <h1 id="hero-title">
      <span class="line">Every case gets</span>
      <span class="line">its own <span class="corner">corner</span>.<span class="caret" aria-hidden="true"></span></span>
    </h1>
    <div class="intro">
      <p class="pitch">
        <strong>cornercase</strong> is a terminal multiplexer for parallel work. Every project, git worktree and coding agent
        gets its own place on screen, and every action is a click. There is no prefix key to learn.
      </p>
      <div class="side">
        <div class="ctas">
          <a class="btn btn-primary" href="#install">
            Install cornercase
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10h10m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </a>
          <a class="btn btn-ghost" href={`${base}/docs/`}>Read the docs</a>
        </div>
        <p class="meta">Rust · Linux &amp; macOS · MIT or Apache-2.0</p>
      </div>
    </div>

    <div class="stage">
      <div class="marks" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      <Demo
        kind="hero"
        fallback="hero"
        title="cornercase — ~/code/shop"
        label="A live simulation of cornercase: projects on the left, workspaces and tabs in the middle, a split tab with an agent, tests and a shell on the right.">
        <div class="demo-bar">
          <p class="narration" data-narration aria-live="polite">
            This is a live simulation. Click anything: projects, tabs, <code>+ new workspace</code>, <code>issues</code>. Right-click a pane to split it.
          </p>
          <div class="controls">
            <button class="tui tour" type="button" data-tour aria-pressed="false">
              <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 2l7 4-7 4z" fill="currentColor"></path></svg>
              take the tour
            </button>
            <button class="tui dim" type="button" data-reset>reset</button>
          </div>
        </div>
      </Demo>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(36px, 5.5vw, 76px);
    padding-bottom: clamp(70px, 9vw, 120px);
    isolation: isolate;
  }

  .backdrop {
    position: absolute;
    inset: -120px 0 0;
    z-index: -1;
    background:
      radial-gradient(600px 380px at 12% 8%, rgb(135 95 255 / 0.22), transparent 70%),
      radial-gradient(700px 420px at 92% 30%, rgb(69 217 232 / 0.09), transparent 70%),
      radial-gradient(900px 500px at 50% 78%, rgb(135 95 255 / 0.16), transparent 70%);
    pointer-events: none;
  }

  .backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgb(255 255 255 / 0.075) 1px, transparent 0);
    background-size: 24px 24px;
    mask-image: radial-gradient(ellipse 70% 55% at 50% 30%, #000 30%, transparent 75%);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 34px;
    padding: 0 12px 0 5px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: rgb(255 255 255 / 0.03);
    color: var(--text-2);
    font-size: 13.5px;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .badge:hover {
    border-color: rgb(168 141 255 / 0.6);
  }

  .badge-tag {
    padding: 3px 9px;
    border-radius: 999px;
    background: rgb(135 95 255 / 0.2);
    color: var(--purple-3);
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .badge svg {
    width: 14px;
    height: 14px;
  }

  h1 {
    margin: 26px 0 0;
    font-family: var(--font-display);
    font-weight: 780;
    font-size: clamp(46px, 8.4vw, 118px);
    line-height: 0.9;
    letter-spacing: -0.045em;
    font-variation-settings: 'opsz' 96;
  }

  .line {
    display: block;
  }

  .corner {
    position: relative;
    color: transparent;
    background: linear-gradient(100deg, var(--purple-2) 10%, #d8cbff 55%, var(--cyan) 110%);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .corner::before {
    content: '';
    position: absolute;
    left: -0.13em;
    top: 0.08em;
    width: 0.26em;
    height: 0.26em;
    border-left: 0.07em solid var(--purple);
    border-top: 0.07em solid var(--purple);
  }

  .caret {
    display: inline-block;
    width: 0.36em;
    height: 0.74em;
    margin-left: 0.08em;
    vertical-align: -0.03em;
    background: var(--cyan);
    border-radius: 2px;
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 26px 48px;
    margin-top: clamp(26px, 3vw, 40px);
  }

  .pitch {
    flex: 1 1 460px;
    max-width: 640px;
    margin: 0;
    font-size: clamp(17px, 1.45vw, 20px);
    line-height: 1.6;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .pitch strong {
    color: var(--text);
    font-weight: 600;
  }

  .side {
    flex: 0 1 auto;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .meta {
    margin: 16px 0 0;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.04em;
    color: var(--text-3);
  }

  .stage {
    position: relative;
    margin-top: clamp(40px, 5vw, 64px);
  }

  .demo-bar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
    margin-top: 16px;
    padding-inline: 4px;
  }

  .narration {
    margin: 0;
    min-height: 3.2em;
    max-width: 820px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-2);
  }

  .narration::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 1em;
    margin-right: 10px;
    vertical-align: -0.12em;
    background: var(--cyan);
  }

  .controls {
    display: flex;
    gap: 6px;
    flex: none;
  }

  .controls .tour {
    padding: 5px 13px;
    border: 1px solid rgb(69 217 232 / 0.45);
    border-radius: 999px;
  }

  .tour svg {
    width: 10px;
    height: 10px;
  }

  @media (max-width: 640px) {
    .demo-bar {
      flex-direction: column-reverse;
      gap: 8px;
    }

    .marks {
      inset: -8px;
    }

    .marks :global(i) {
      width: 14px;
      height: 14px;
    }
  }
</style>
