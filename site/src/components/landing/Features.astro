---
import Snapshot from './Snapshot.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const programs = ['nvim', 'fzf', 'htop', 'lazygit', 'btop', 'claude', 'codex', 'gemini'];
---

<section class="section features" id="features" aria-labelledby="features-title">
  <div class="wrap">
    <div class="head reveal">
      <p class="eyebrow">What you get</p>
      <h2 class="h2" id="features-title">Built for working on <em>five things at once.</em></h2>
      <p class="lead">
        A fix on one branch, a feature on another, an agent chewing through an issue in a third. cornercase keeps each one in its
        own corner, one click away.
      </p>
    </div>

    <div class="bento">
      <article class="card a reveal">
        <div class="text">
          <h3>One place for every line of work</h3>
          <p>A sidebar of projects, in groups if you like. For the active one, its workspaces and their tabs. Click to switch, <code>+</code> to create, right-click to rename.</p>
          <dl class="terms">
            <div><dt>project</dt><dd>a folder you work in</dd></div>
            <div><dt>workspace</dt><dd>a line of work: the project folder, or its own git worktree</dd></div>
            <div><dt>tab</dt><dd>one or more shells, labelled by what runs in them</dd></div>
            <div><dt>pane</dt><dd>a split inside a tab</dd></div>
          </dl>
        </div>
        <Snapshot scene="sidebar" label="The projects column with shop, api, infra and notes, and the workspaces of shop: main and feat/dark-mode, with their tabs." class="shot" />
      </article>

      <article class="card b reveal">
        <div class="text">
          <h3>A worktree per workspace</h3>
          <p>
            In a repository, tick one box and the workspace gets its own checkout and branch. Worktrees you made elsewhere show up
            too, and files listed in <code>.worktreeinclude</code> such as <code>.env</code> are copied in.
          </p>
        </div>
        <Snapshot scene="worktree" label="The new workspace form: name feat/login, in ~/.cornercase/worktrees/shop/feat-login, with its own worktree ticked." class="shot" />
      </article>

      <article class="card c reveal">
        <div class="text">
          <h3>Issues in, agents out</h3>
          <p>GitHub, Shortcut and Linear in one list. Read an issue as Markdown, press <span class="kb">start</span>, and an agent takes it in its own worktree.</p>
        </div>
        <Snapshot scene="issues" label="The issues dialog listing six GitHub issues for the shop project, the first one selected." class="shot" />
      </article>

      <article class="card d reveal">
        <div class="text">
          <h3>Splits that join up</h3>
          <p>Right-click any pane to split it right or down. Drag the dividers. Inactive panes dim so you always know where you type.</p>
        </div>
        <Snapshot scene="splits" label="A tab split in three panes with the pane menu open: split right, split down, send right-clicks to the pane, close pane." class="shot" />
      </article>

      <article class="card f reveal">
        <div class="text">
          <h3>Fits any window</h3>
          <p>Below 90 columns the columns fold into a menu bar with big, easy rows. Same app, phone-sized.</p>
        </div>
        <div class="phone">
          <Snapshot scene="compact" label="cornercase at 44 columns: a top bar with the menu, breadcrumb and search, and the workspaces menu open." class="shot" />
        </div>
      </article>

      <article class="card e reveal">
        <div class="text">
          <h3>Search everything</h3>
          <p>Projects, workspaces, branches and tabs, ranked as you type. <kbd>Enter</kbd> takes you there.</p>
        </div>
        <Snapshot scene="search" label="Search for feat: the feat/dark-mode and feat/login workspaces and their tabs." class="shot" />
      </article>

      <article class="card i reveal">
        <div class="text">
          <h3>Copy by dragging</h3>
          <p>Drag over text in a pane and it is on your clipboard, through OSC 52, so it works over SSH as well.</p>
        </div>
        <Snapshot scene="copied" label="A pane with a toast in the corner: copied to clipboard." class="shot" />
      </article>

      <article class="card g reveal">
        <div class="text">
          <h3>A real terminal core</h3>
          <p>
            Every pane runs on <a href="https://github.com/ghostty-org/ghostty">libghostty-vt</a>, Ghostty's own emulator. It answers
            the queries modern programs wait for, reflows on resize and speaks the kitty keyboard protocol.
          </p>
          <ul class="programs" aria-label="Programs that work inside cornercase">
            {programs.map((p) => <li>{p}</li>)}
          </ul>
        </div>
        <Snapshot scene="editor" label="nvim editing src/returns/address.rs with line numbers and syntax highlighting." class="shot" />
      </article>

      <article class="card h reveal">
        <div class="text">
          <h3>Your theme, not ours</h3>
          <p>cornercase asks your terminal for its colors and draws with your palette, so it looks at home in any theme, light or dark.</p>
        </div>
        <div class="themes">
          <Snapshot scene="projects" theme="midnight" label="The projects column in a dark purple theme." class="shot" />
          <Snapshot scene="projectsLight" theme="paper" label="The projects column in a light theme." class="shot" />
          <Snapshot scene="projects" theme="ember" label="The projects column in a warm dark theme." class="shot" />
        </div>
      </article>
    </div>

    <p class="more reveal">
      Every feature, in detail: <a href={`${base}/docs/`}>read the documentation</a>.
    </p>
  </div>
</section>

<style>
  .head {
    max-width: 860px;
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-areas:
      'a a b'
      'c d f'
      'e i f'
      'g h h';
    gap: 18px;
    margin-top: clamp(40px, 6vw, 72px);
  }

  .a {
    grid-area: a;
  }
  .b {
    grid-area: b;
  }
  .c {
    grid-area: c;
  }
  .d {
    grid-area: d;
  }
  .e {
    grid-area: e;
  }
  .f {
    grid-area: f;
  }
  .g {
    grid-area: g;
  }
  .h {
    grid-area: h;
  }
  .i {
    grid-area: i;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-width: 0;
    padding: clamp(20px, 2.2vw, 28px);
    border-radius: 18px;
    border: 1px solid var(--line);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.025), transparent 40%), var(--panel);
    overflow: hidden;
    transition:
      border-color 0.3s ease,
      transform 0.3s ease;
  }

  .card:hover {
    border-color: rgb(135 95 255 / 0.4);
  }

  .card::before {
    content: '';
    position: absolute;
    left: -1px;
    top: -1px;
    width: 18px;
    height: 18px;
    border-left: 2px solid var(--purple);
    border-top: 2px solid var(--purple);
    border-top-left-radius: 18px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .card:hover::before {
    opacity: 1;
  }

  h3 {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-size: 23px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .text p {
    margin: 0;
    color: var(--text-2);
    font-size: 15.5px;
    line-height: 1.6;
  }

  .text a {
    color: var(--purple-3);
    text-decoration-color: rgb(201 184 255 / 0.4);
    text-underline-offset: 3px;
  }

  .kb {
    padding: 1px 6px;
    border-radius: 3px;
    background: var(--cyan);
    color: #07060b;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
  }

  kbd {
    padding: 1px 6px;
    border-radius: 5px;
    border: 1px solid var(--line-2);
    font-size: 12.5px;
  }

  .shot {
    margin-top: auto;
    box-shadow: 0 20px 50px -30px rgb(0 0 0 / 0.9);
  }

  .a {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: 28px;
  }

  .a .shot {
    margin-top: 0;
  }

  .terms {
    display: grid;
    gap: 10px;
    margin: 22px 0 0;
  }

  .terms div {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 12px;
    align-items: baseline;
  }

  .terms dt {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--cyan);
  }

  .terms dt::before {
    content: '▌';
    margin-right: 6px;
    color: var(--cyan);
  }

  .terms dd {
    margin: 0;
    color: var(--text-2);
    font-size: 14.5px;
  }

  .phone {
    margin: auto;
    width: min(100%, 300px);
    padding: 12px 8px 18px;
    border-radius: 34px;
    border: 1px solid rgb(255 255 255 / 0.14);
    background: #050408;
    box-shadow:
      inset 0 0 0 4px #121019,
      0 30px 60px -30px rgb(135 95 255 / 0.5);
  }

  .phone .shot {
    border-radius: 22px;
    padding: 18px 8px 10px;
    box-shadow: none;
  }

  .programs {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .programs li {
    padding: 4px 10px;
    border-radius: 6px;
    border: 1px solid var(--line-2);
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text-2);
  }

  .themes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: auto;
  }

  .themes .shot {
    padding: 6px 7px;
  }

  .more {
    margin: 36px 0 0;
    color: var(--text-3);
  }

  .more a {
    color: var(--text);
    text-underline-offset: 4px;
    text-decoration-color: var(--purple);
  }

  @media (max-width: 1060px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        'a a'
        'b c'
        'd e'
        'f i'
        'f g'
        'h h';
    }
  }

  @media (max-width: 720px) {
    .bento {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'a' 'b' 'c' 'd' 'f' 'e' 'i' 'g' 'h';
    }

    .a {
      grid-template-columns: minmax(0, 1fr);
    }

    .themes {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
