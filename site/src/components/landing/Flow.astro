---
import Demo from './Demo.astro';

const steps: [string, string][] = [
  ['Pick an issue', 'GitHub issues through <code>gh</code>, Shortcut stories and Linear issues side by side. Filter by state or people, read any of them as Markdown.'],
  ['Press start', 'The agent is the one you set, the one already running in your tab, or cornercase asks. Its arguments come from settings.'],
  ['A worktree on its own branch', '<code>git worktree add</code> on <code>issue-482-returns-page-crashes-on-empty-address</code>, with the files listed in <code>.worktreeinclude</code>, like your <code>.env</code>, copied in.'],
  ['Your agent starts', '<code>claude --permission-mode plan</code> is typed in a new tab once the shell is quiet. “Do you trust this folder?” is answered for you.'],
  ['The issue lands in its prompt', 'The link is pasted and waits for your <kbd>Enter</kbd>, or is sent for you. The agent works while you review something else.'],
];
---

<section class="section flow" id="flow" aria-labelledby="flow-title">
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap">
    <div class="head reveal">
      <p class="eyebrow">Issues to agents</p>
      <h2 class="h2" id="flow-title">From issue to agent <em>in one click.</em></h2>
      <p class="lead">
        Point an agent at an issue and cornercase does the boring part: a fresh worktree, the right branch, the agent in its own
        tab and the issue in its prompt. Run three at once if you like; each one keeps its corner.
      </p>
    </div>
    <div class="grid">
      <ol class="steps reveal">
        {
          steps.map(([title, body], i) => (
            <li data-step>
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{title}</h3>
                <p set:html={body} />
              </div>
            </li>
          ))
        }
      </ol>
      <div class="player reveal">
        <Demo kind="flow" fallback="detail" title="issues · shop" label="A simulation of cornercase opening issue 482, creating a worktree and starting an agent on it.">
          <div class="foot">
            <span>Plays on its own. Click inside to take over.</span>
            <button class="tui" type="button" data-replay hidden>
              <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3.5 8a4.5 4.5 0 1 0 1.4-3.3M3.5 2.5v3h3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              replay
            </button>
          </div>
        </Demo>
      </div>
    </div>
  </div>
</section>

<style>
  .flow {
    overflow: hidden;
  }

  .glow {
    position: absolute;
    inset: 10% -10% auto;
    height: 70%;
    background: radial-gradient(50% 50% at 70% 50%, rgb(135 95 255 / 0.14), transparent 70%);
    pointer-events: none;
  }

  .head {
    max-width: 860px;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
    margin-top: clamp(40px, 6vw, 72px);
  }

  .steps {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    display: grid;
    grid-template-columns: 38px 1fr;
    gap: 12px;
    padding: 16px 16px 16px 14px;
    border-radius: 14px;
    border: 1px solid transparent;
    transition:
      background-color 0.35s ease,
      border-color 0.35s ease,
      opacity 0.35s ease;
  }

  .steps li.active {
    background: rgb(135 95 255 / 0.09);
    border-color: rgb(135 95 255 / 0.35);
  }

  .n {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-3);
    padding-top: 3px;
  }

  .active .n {
    color: var(--cyan);
  }

  h3 {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .steps p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-2);
  }

  .steps p :global(kbd) {
    padding: 0 6px;
    border-radius: 5px;
    border: 1px solid var(--line-2);
    font-size: 12px;
  }

  .player {
    position: sticky;
    top: 96px;
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 12px;
    padding-inline: 4px;
    font-size: 13.5px;
    color: var(--text-3);
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .player {
      position: relative;
      top: 0;
      order: -1;
    }
  }
</style>
