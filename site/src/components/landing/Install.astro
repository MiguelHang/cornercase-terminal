---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const install = 'curl -fsSL https://usecornercase.dev/install.sh | sh';
---

<section class="section install" id="install" aria-labelledby="install-title">
  <div class="wrap">
    <div class="panel reveal">
      <div class="copy">
        <p class="eyebrow">Install</p>
        <h2 class="h2" id="install-title">One command. <em>Then click.</em></h2>
        <p class="lead">A single binary for Linux and macOS, on x86_64 and arm64. Once it's in, cornercase keeps itself up to date.</p>
        <ul class="needs">
          <li><strong>install script</strong><span>puts <code>cornercase</code> in <code>~/.local/bin</code> and adds it to your <code>PATH</code></span></li>
          <li><strong>Homebrew</strong><span><code>brew install usecornercase/tap/cornercase</code></span></li>
          <li><strong>updates</strong><span>a button in the sidebar when a new version is out: one click to update, one to restart</span></li>
          <li><strong>from source</strong><span>with Rust and Zig 0.15.2: see <a href={`${base}/docs/installation/#from-source`}>building from source</a></span></li>
        </ul>
      </div>
      <div class="term">
        <div class="term-bar">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>install</span>
          <button class="copy-btn" type="button" data-copy={install}>
            <span class="idle">copy</span><span class="done">copied</span>
          </button>
        </div>
        <pre><code><span class="cmd"><span class="ps">$</span>{install}</span><span class="out dim"># downloads the latest release into ~/.local/bin</span><span class="cmd"><span class="ps">$</span>cornercase --version</span><span class="out ok">cornercase 0.1.0</span><span class="cmd"><span class="ps">$</span>cornercase</span><span class="out dim"># opens the UI and starts the server if needed</span><span class="cmd"><span class="ps">$</span>cornercase kill-server</span><span class="out dim"># stops the server and every shell in it</span></code></pre>
      </div>
    </div>
    <p class="after reveal">
      Next: <a href={`${base}/docs/first-steps/`}>first steps</a> · <a href={`${base}/docs/installation/`}>installation details</a> ·
      <a href={`${base}/docs/help/troubleshooting/`}>troubleshooting</a>
    </p>
  </div>
</section>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.classList.add('copied');
        setTimeout(() => button.classList.remove('copied'), 1600);
      } catch {}
    });
  }
</script>

<style>
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    padding: clamp(24px, 4vw, 56px);
    border-radius: 28px;
    border: 1px solid rgb(135 95 255 / 0.3);
    background:
      radial-gradient(700px 360px at 0% 0%, rgb(135 95 255 / 0.18), transparent 70%),
      radial-gradient(600px 300px at 100% 100%, rgb(69 217 232 / 0.08), transparent 70%),
      var(--panel);
  }

  .needs {
    display: grid;
    gap: 12px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .needs li {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 12px;
    align-items: baseline;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 15px;
  }

  .needs strong {
    font-family: var(--font-mono);
    font-size: 13.5px;
    color: var(--text);
  }

  .needs span {
    color: var(--text-2);
  }

  .needs code {
    overflow-wrap: anywhere;
  }

  .needs a {
    color: var(--text);
    text-underline-offset: 4px;
    text-decoration-color: var(--purple);
  }

  .term {
    border-radius: 16px;
    border: 1px solid var(--line-2);
    background: var(--term);
    overflow: hidden;
    box-shadow: 0 30px 70px -30px rgb(0 0 0 / 0.9);
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 40px;
    padding: 0 10px 0 14px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-3);
  }

  .term-bar > span:nth-child(2) {
    flex: 1;
  }

  .copy-btn {
    display: inline-grid;
    padding: 4px 10px;
    border: 0;
    border-radius: 3px;
    background: transparent;
    color: var(--cyan);
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 700;
    cursor: pointer;
  }

  .copy-btn span {
    grid-area: 1 / 1;
  }

  .copy-btn .done {
    visibility: hidden;
  }

  .copy-btn:hover {
    background: var(--cyan);
    color: #07060b;
  }

  .copy-btn.copied {
    background: var(--green);
    color: #07060b;
  }

  .copy-btn.copied .idle {
    visibility: hidden;
  }

  .copy-btn.copied .done {
    visibility: visible;
  }

  pre {
    margin: 0;
    padding: 18px 20px 22px;
    overflow-x: auto;
    font-size: 13px;
    line-height: 1.85;
  }

  pre code {
    display: grid;
  }

  .cmd {
    padding-left: 1.4em;
    text-indent: -1.4em;
    color: var(--text);
    white-space: pre-wrap;
    word-break: break-all;
  }

  .ps {
    display: inline-block;
    width: 1.4em;
    color: var(--purple-2);
    user-select: none;
  }

  .out {
    color: var(--text-2);
    white-space: pre;
  }

  .ok {
    color: var(--green);
  }

  .dim {
    color: var(--text-3);
    margin-bottom: 4px;
  }

  .after {
    margin: 26px 0 0;
    text-align: center;
    color: var(--text-3);
  }

  .after a {
    color: var(--text);
    text-underline-offset: 4px;
    text-decoration-color: var(--purple);
  }

  @media (max-width: 960px) {
    .panel {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 520px) {
    .needs li {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
